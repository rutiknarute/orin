# Cache rules for static assets. This file replaces the one vinext generates,
# so the content-hashed rule below has to be repeated here.

# Build output carries a content hash in the filename.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted fonts and brand art have stable filenames, so they get a long
# but finite lifetime rather than `immutable`.
/fonts/*
  Cache-Control: public, max-age=2592000

/*.png
  Cache-Control: public, max-age=2592000

/*.svg
  Cache-Control: public, max-age=2592000
