{
  "brand": "Orin",
  "primitive": {
    "color": {
      "navy": { "900": "#061126", "800": "#0A172D", "700": "#13233F" },
      "blue": { "700": "#043DBD", "600": "#064AE4", "500": "#2463EB", "400": "#3E92F4", "100": "#DCE8FF" },
      "slate": { "700": "#33415C", "500": "#5B667A", "200": "#DDE4EE", "100": "#EDF1F7", "50": "#F5F7FB" },
      "white": "#FFFFFF",
      "success": "#14866D",
      "warning": "#B86F00",
      "error": "#C83B4D"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "12": "48px", "16": "64px" },
    "radius": { "sm": "8px", "md": "12px", "lg": "18px", "xl": "24px", "full": "999px" },
    "duration": { "fast": "160ms", "normal": "220ms", "slow": "320ms" }
  },
  "semantic": {
    "color": {
      "background": "{primitive.color.slate.50}",
      "surface": "{primitive.color.white}",
      "foreground": "{primitive.color.navy.800}",
      "mutedForeground": "{primitive.color.slate.500}",
      "primary": "{primitive.color.blue.600}",
      "primaryHover": "{primitive.color.blue.700}",
      "border": "{primitive.color.slate.200}",
      "success": "{primitive.color.success}",
      "warning": "{primitive.color.warning}",
      "error": "{primitive.color.error}"
    }
  },
  "component": {
    "button": { "height": "44px", "radius": "{primitive.radius.md}", "duration": "{primitive.duration.fast}" },
    "input": { "height": "46px", "radius": "{primitive.radius.md}" },
    "card": { "radius": "{primitive.radius.lg}", "border": "{semantic.color.border}" }
  }
}
