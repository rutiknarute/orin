{
  "brand": "Orin",
  "primitive": {
    "color": {
      "navy": { "950": "#040B18", "900": "#061126", "800": "#0A172D", "700": "#13233F" },
      "blue": { "700": "#043DBD", "600": "#064AE4", "500": "#2463EB", "400": "#3E92F4", "100": "#DCE8FF" },
      "slate": { "700": "#33415C", "500": "#5B667A", "300": "#CBD4E1", "200": "#DCE3ED", "100": "#EDF1F7", "50": "#F4F6FA" },
      "white": "#FFFFFF",
      "success": "#14866D",
      "warning": "#B86F00",
      "error": "#C83B4D"
    },
    "space": { "1": "4px", "2": "8px", "3": "12px", "4": "16px", "5": "20px", "6": "24px", "8": "32px", "10": "40px", "12": "48px", "16": "64px", "20": "80px", "24": "96px" },
    "radius": { "sm": "10px", "md": "14px", "lg": "22px", "xl": "32px", "full": "999px" },
    "duration": { "fast": "180ms", "normal": "240ms", "slow": "360ms" }
  },
  "semantic": {
    "color": {
      "background": "{primitive.color.slate.50}",
      "surface": "{primitive.color.white}",
      "surfaceElevated": "{primitive.color.white}",
      "foreground": "{primitive.color.navy.800}",
      "mutedForeground": "{primitive.color.slate.500}",
      "primary": "{primitive.color.blue.600}",
      "primaryHover": "{primitive.color.blue.700}",
      "accent": "{primitive.color.blue.400}",
      "border": "{primitive.color.slate.200}",
      "success": "{primitive.color.success}",
      "warning": "{primitive.color.warning}",
      "error": "{primitive.color.error}"
    }
  },
  "component": {
    "button": { "height": "48px", "radius": "{primitive.radius.md}", "duration": "{primitive.duration.fast}" },
    "input": { "height": "50px", "radius": "{primitive.radius.md}" },
    "card": { "radius": "{primitive.radius.lg}", "border": "{semantic.color.border}" }
  }
}
